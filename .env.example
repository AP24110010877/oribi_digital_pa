# Orbi — A Digital PA: Environment Variables

# Backend Flask Configuration
FLASK_ENV=development
SECRET_KEY=replace-with-a-secure-random-secret-key-32-chars
PORT=5000

# Supabase Configuration (Optional for cloud sync; local SQLite fallback active by default)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-public-key
SUPABASE_SERVICE_KEY=your-service-role-key

# AI Intelligence API (Google Gemini or LLM)
GEMINI_API_KEY=your-gemini-api-key

# Storage & Uploads
UPLOAD_FOLDER=backend/uploads
DATABASE_PATH=backend/orbi.db
